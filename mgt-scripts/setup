#!/usr/bin/env bash
# ReviewNudge Industries application setup. Portmason sources this during pm-setup.

reviewnudge_industries_setup_main() {
  local project_root site_dir installer provider

  project_root="${PROJECT_ROOT:-$(pwd)}"
  site_dir="${project_root}/www"
  provider="${PM_WEB_ANALYTICS_PROVIDER:-}"

  [[ -z "$provider" ]] && return 0
  [[ "$provider" == "google-tag-manager" ]] \
    || { printf 'ERROR: Unsupported ReviewNudge Industries analytics provider: %s\n' "$provider" >&2; return 2; }

  installer="$(command -v pm-install-web-analytics || true)"
  if [[ -z "$installer" && -x "${PORTMASON_SHARE:-}/pm-install-web-analytics" ]]; then
    installer="${PORTMASON_SHARE}/pm-install-web-analytics"
  fi
  [[ -x "$installer" ]] \
    || { printf 'ERROR: ReviewNudge Industries requires pm-install-web-analytics\n' >&2; return 2; }

  "$installer" \
    --site-dir "$site_dir" \
    --all-html \
    --site-name "ReviewNudge Industries"
}

reviewnudge_industries_setup_main "$@"
reviewnudge_industries_setup_rc=$?

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  exit "$reviewnudge_industries_setup_rc"
fi
return "$reviewnudge_industries_setup_rc"
